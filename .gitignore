# Python 캐시 파일 무시
__pycache__/
*.py[cod]
*$py.class
*.so

# 가상환경 무시
venv/
.venv/
env/

# 환경 변수 및 보안 키 무시 (절대 커밋 금지)
.env
*.local.env

# 격리 데이터 무시
data/quarantine/*
!data/quarantine/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/cleaned_pir_dataset.csv

# 로그 파일 무시
logs/
*.log

# IDE 설정 및 OS 임시 파일 무시
.vscode/
.idea/
.DS_Store
Thumbs.db
