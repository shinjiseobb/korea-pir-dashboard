# Python 캐시 파일 무시
__pycache__/
*.py[cod]
*$py.class
*.so

# 가상환경 무시
venv/
.venv/
env/

# 환경 변수 및 보안 키 무시 (절대 커밋 금지)
.env
*.local.env

# 원천 데이터 및 정제 데이터 (대용량/개인정보 보호 차원)
data/raw/*
!data/raw/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Vercel 배포를 위한 최종 정제 데이터셋은 포함
!data/processed/cleaned_pir_dataset.csv

# 로그 파일 무시
logs/
*.log

# IDE 설정 및 OS 임시 파일 무시
.vscode/
.idea/
.DS_Store
Thumbs.db
